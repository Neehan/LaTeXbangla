\InheritBibliographyExtras{english}
% Heading strings use the selected language's captured Polyglossia captions.
% Reuse that implementation and replace only the language-specific conjunctions.
\InheritBibliographyStrings{latexbangla-bengali}
\DeclareBibliographyStrings{
  and       = {{আৰু}{আৰু}},
  andothers = {{আৰু অন্যান্য}{আৰু অন্যান্য}},
}
\endinput
